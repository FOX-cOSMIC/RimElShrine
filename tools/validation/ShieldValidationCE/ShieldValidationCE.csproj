<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ShieldValidation.CombatExtended</AssemblyName>
    <RootNamespace>ShieldValidation</RootNamespace>
    <LangVersion>13</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>..\ShieldValidation\Compatible\CombatExtended\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- The CE build the game runs. The runner uses the same folder, so compile and run share one assembly. -->
  <PropertyGroup>
    <CombatExtendedRef Condition="'$(CombatExtendedRef)' == ''">$(USERPROFILE)\.rimworld-refs\CombatExtended-1.7-Test-src\Assemblies\CombatExtended.dll</CombatExtendedRef>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4995-unstable" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RimElShrine.Shields">
      <HintPath>..\..\..\RimElShrine.Shields\1.7\Assemblies\RimElShrine.Shields.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RimElShrine">
      <HintPath>..\..\..\RimElShrine.Shields\1.7\Assemblies\RimElShrine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- The main validation assembly, for DemoScene and ValidationSupport. -->
    <Reference Include="ShieldValidation">
      <HintPath>..\ShieldValidation\Assemblies\ShieldValidation.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CombatExtended">
      <HintPath>$(CombatExtendedRef)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
