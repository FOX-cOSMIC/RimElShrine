<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ShieldValidation</AssemblyName>
    <RootNamespace>ShieldValidation</RootNamespace>
    <LangVersion>13</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4995-unstable" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RimElShrine.Shields">
      <HintPath>..\..\..\RimElShrine.Shields\1.7\Assemblies\RimElShrine.Shields.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RimElShrine">
      <HintPath>..\..\..\RimElShrine.Shields\1.7\Assemblies\RimElShrine.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
